{
  "info": {
    "_postman_id": "2feb8d7b-c7d0-4b3e-a840-cb83abdc9a34",
    "name": "Proyecto Ark - Notification Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion de notificaciones. Requiere Bearer token."
  },
  "item": [
    {
      "name": "Consultar notificaciones por orden",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/notifications/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notifications",
            "orders",
            "{{orderId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Crear recordatorio de carrito",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cartId\": {{cartId}},\n  \"customerId\": \"client\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/notifications/cart-reminders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notifications",
            "cart-reminders"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "cartId",
      "value": "1"
    }
  ]
}
