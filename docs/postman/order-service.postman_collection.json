{
  "info": {
    "_postman_id": "dbc95190-c3b7-47bf-b5bf-c7f9d30c74da",
    "name": "Proyecto Ark - Order Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion de ordenes y carritos. Requiere Bearer token."
  },
  "item": [
    {
      "name": "Ordenes",
      "item": [
        {
          "name": "Crear orden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"client\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Modificar orden",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"client\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 1\n    },\n    {\n      \"productId\": 3,\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Solo funciona si la orden sigue en estado PENDING."
          },
          "response": []
        },
        {
          "name": "Listar ordenes confirmadas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/confirmed?start={{startDate}}&end={{endDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "confirmed"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "{{startDate}}"
                },
                {
                  "key": "end",
                  "value": "{{endDate}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Carritos",
      "item": [
        {
          "name": "Guardar carrito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"client\",\n  \"status\": \"ABANDONED\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 1\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 3\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/carts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts"
              ]
            },
            "description": "Estados permitidos: ACTIVE, ABANDONED, CONVERTED."
          },
          "response": []
        },
        {
          "name": "Listar carritos abandonados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/abandoned",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "abandoned"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Enviar recordatorio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/reminder",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "reminder"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "cartId",
      "value": "1"
    },
    {
      "key": "startDate",
      "value": "2026-04-01T00:00:00Z"
    },
    {
      "key": "endDate",
      "value": "2026-04-15T23:59:59Z"
    }
  ]
}
